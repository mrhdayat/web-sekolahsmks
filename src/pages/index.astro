---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Beranda" bodyClass="overflow-x-hidden"> {/* Tambahkan overflow-x-hidden jika parallax menyebabkan scroll horizontal */}
  <section
    id="hero-section"
    class="relative min-h-[calc(100vh-var(--navbar-height-desktop))] md:min-h-[calc(100vh-var(--navbar-height-mobile))] flex items-center justify-center text-white overflow-hidden scroll-snap-align-start"
  >
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style="background-image: url('/images/placeholders/hero-bg.jpg'); background-attachment: fixed;"
      id="hero-bg-parallax"
    >
       <div class="absolute inset-0 bg-black/50"></div> {/* Overlay gelap */}
    </div>
    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 text-center z-10 py-12 md:py-20"> {/* Tambah z-10 dan padding */}
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 animate-fade-up" transition:name="main-title">
        SMKS Muhammadiyah Satui
      </h1>
      <p class="text-lg md:text-xl lg:text-2xl mb-8 max-w-2xl mx-auto animate-fade-up animation-delay-300" style="--animation-delay: 0.3s;">
        Mencetak Generasi Unggul, Berkarakter, dan Kompeten di Bidangnya.
      </p>
      <div class="space-x-4 animate-fade-up animation-delay-600" style="--animation-delay: 0.6s;">
        <a href="/tentang" class="bg-white text-sky-600 dark:bg-slate-800 dark:text-sky-400 font-semibold px-8 py-3 rounded-lg shadow-lg hover:bg-opacity-90 dark:hover:bg-opacity-90 transform hover:scale-105 transition duration-300">
          Tentang Kami
        </a>
        <a href="/program" class="border-2 border-white text-white font-semibold px-8 py-3 rounded-lg shadow-lg hover:bg-white hover:text-sky-600 dark:hover:bg-slate-100 dark:hover:text-sky-700 transform hover:scale-105 transition duration-300">
          Program Keahlian
        </a>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-slate-100 dark:bg-slate-800 scroll-snap-align-start flex items-center min-h-[calc(100vh-var(--navbar-height-desktop))]">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-slate-800 dark:text-slate-100">
        Kenapa Memilih Kami?
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-slate-700 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <h3 class="text-xl font-semibold text-sky-600 dark:text-sky-400 mb-3">Kurikulum Terkini</h3>
          <p class="text-slate-600 dark:text-slate-300">Kurikulum yang relevan dengan kebutuhan industri saat ini dan masa depan.</p>
        </div>
        <div class="bg-white dark:bg-slate-700 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <h3 class="text-xl font-semibold text-sky-600 dark:text-sky-400 mb-3">Fasilitas Lengkap</h3>
          <p class="text-slate-600 dark:text-slate-300">Dukungan fasilitas modern untuk praktik dan pembelajaran yang optimal.</p>
        </div>
        <div class="bg-white dark:bg-slate-700 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300">
          <h3 class="text-xl font-semibold text-sky-600 dark:text-sky-400 mb-3">Guru Profesional</h3>
          <p class="text-slate-600 dark:text-slate-300">Tenaga pendidik yang berpengalaman dan berdedikasi tinggi.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* Helper untuk delay animasi */
    .animation-delay-300 {
      animation-delay: 0.3s;
    }
    .animation-delay-600 {
      animation-delay: 0.6s;
    }
    /* Animasi fade-up (jika belum ada di tailwind.config.mjs atau ingin spesifik) */
    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-up {
      animation: fade-up 0.8s ease-out forwards;
      opacity: 0; /* Start with opacity 0 to avoid flash of unstyled content */
    }
  </style>
</Layout>
