---
// src/pages/admin/dashboard/guru/index.astro
import AdminLayout from '@layouts/AdminLayout.astro';
import { getSemuaGuru, type Guru, supabase } from '@lib/supabase'; // Impor supabase juga untuk delete

let daftarGuru: Guru[] = [];
let message: string | null = Astro.url.searchParams.get('message');
let error: string | null = Astro.url.searchParams.get('error');

try {
  daftarGuru = await getSemuaGuru();
} catch (e: any) {
  console.error("Gagal memuat data guru untuk admin:", e);
  error = "Gagal memuat data guru. " + e.message;
}

if (Astro.request.method === 'POST') {
  // Handle Delete Action
  const formData = await Astro.request.formData();
  const action = formData.get('_action');
  const guruId = formData.get('guruId');

  if (action === 'delete' && guruId && supabase) {
    try {
      const { error: deleteError } = await supabase
        .from('guru')
        .delete()
        .match({ id: guruId });

      if (deleteError) {
        throw new Error(deleteError.message);
      }
      // Re-fetch data after delete or simply redirect with a success message
      return Astro.redirect('/admin/dashboard/guru?message=Data guru berhasil dihapus.');
    } catch (e: any) {
      console.error("Error deleting guru:", e);
      // Redirect with error message
      return Astro.redirect(`/admin/dashboard/guru?error=Gagal menghapus data guru: ${e.message}`);
    }
  }
}
---
<AdminLayout title="Kelola Data Guru" currentPage="/admin/dashboard/guru">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl md:text-3xl font-bold text-slate-800 dark:text-slate-100">Daftar Guru</h1>
    <a href="/admin/dashboard/guru/tambah" class="btn-primary bg-sky-500 hover:bg-sky-600 text-white font-medium py-2 px-4 rounded-lg shadow-md hover:shadow-lg transition-all duration-200 transform hover:scale-105 inline-flex items-center">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-2">
        <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
      </svg>
      Tambah Guru
    </a>
  </div>

  {message && (
    <div id="success-alert" class="bg-green-100 dark:bg-green-900/50 border border-green-400 dark:border-green-600 text-green-700 dark:text-green-300 px-4 py-3 rounded-md mb-4 relative" role="alert">
      <strong class="font-bold">Sukses!</strong>
      <span class="block sm:inline"> {message}</span>
      <button onclick="document.getElementById('success-alert').remove()" class="absolute top-0 bottom-0 right-0 px-4 py-3 text-green-700 dark:text-green-300">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
      </button>
    </div>
  )}
  {error && (
    <div id="error-alert" class="bg-red-100 dark:bg-red-900/50 border border-red-400 dark:border-red-600 text-red-700 dark:text-red-300 px-4 py-3 rounded-md mb-4 relative" role="alert">
      <strong class="font-bold">Error!</strong>
      <span class="block sm:inline"> {error}</span>
      <button onclick="document.getElementById('error-alert').remove()" class="absolute top-0 bottom-0 right-0 px-4 py-3 text-red-700 dark:text-red-300">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" /></svg>
      </button>
    </div>
  )}

  <div class="bg-white dark:bg-slate-800 shadow-lg rounded-xl overflow-x-auto">
    <table class="w-full table-auto">
      <thead class="text-xs font-semibold uppercase text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-700/50">
        <tr>
          <th class="p-3 whitespace-nowrap"><div class="font-semibold text-left">Nama</div></th>
          <th class="p-3 whitespace-nowrap"><div class="font-semibold text-left">Jabatan</div></th>
          <th class="p-3 whitespace-nowrap"><div class="font-semibold text-left">Mapel</div></th>
          <th class="p-3 whitespace-nowrap"><div class="font-semibold text-center">Foto</div></th>
          <th class="p-3 whitespace-nowrap"><div class="font-semibold text-center">Aksi</div></th>
        </tr>
      </thead>
      <tbody class="text-sm divide-y divide-slate-100 dark:divide-slate-700">
        {daftarGuru.length > 0 ? daftarGuru.map(guru => (
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
            <td class="p-3 whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-10 h-10 shrink-0 mr-2 sm:mr-3">
                  <img class="rounded-full object-cover w-10 h-10" src={guru.foto_url || '/images/placeholders/default-avatar.png'} width="40" height="40" alt={guru.nama} onerror={`this.onerror=null;this.src='/images/placeholders/default-avatar.png';`} />
                </div>
                <div class="font-medium text-slate-800 dark:text-slate-100">{guru.nama}</div>
              </div>
            </td>
            <td class="p-3 whitespace-nowrap"><div class="text-left">{guru.jabatan || '-'}</div></td>
            <td class="p-3 whitespace-nowrap"><div class="text-left">{guru.mapel || '-'}</div></td>
            <td class="p-3 whitespace-nowrap text-center">
              {guru.foto_url ? (
                <a href={guru.foto_url} target="_blank" rel="noopener noreferrer" class="text-sky-500 hover:text-sky-600 dark:hover:text-sky-400 hover:underline text-xs">Lihat</a>
              ) : (
                <span class="text-xs text-slate-400 dark:text-slate-500">-</span>
              )}
            </td>
            <td class="p-3 whitespace-nowrap text-center">
              <a href={`/admin/dashboard/guru/edit/${guru.id}`} class="text-yellow-500 hover:text-yellow-600 dark:hover:text-yellow-400 mr-2 font-medium transition-colors" title="Edit">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 inline">
                    <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
                </svg>
              </a>
              <form method="POST" action={`/admin/dashboard/guru?guruId=${guru.id}&_action=delete`} class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus guru ini?');">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="guruId" value={guru.id} />
                <button type="submit" class="text-red-500 hover:text-red-600 dark:hover:text-red-400 font-medium transition-colors" title="Hapus">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 inline">
                        <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.58.177-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.52.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25V4.075c.827-.05 1.66-.075 2.5-.075zM8.088 7.75a.75.75 0 011.064.062l.056.083.015.025.009.017a.75.75 0 01.002.003l-.002.003-.01.017-.015.025-.056.083a.75.75 0 01-1.12 0l-.056-.083-.015-.025-.01-.017a.75.75 0 01-.001-.003l.002-.003.01-.017.015-.025.056-.083z" clip-rule="evenodd" />
                    </svg>
                </button>
              </form>
            </td>
          </tr>
        )) : (
          <tr>
            <td colspan="5" class="p-4 text-center text-slate-500 dark:text-slate-400">
              Tidak ada data guru yang ditemukan.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>

<script>
// Script untuk menghilangkan alert setelah beberapa detik
document.addEventListener('astro:page-load', () => {
  const successAlert = document.getElementById('success-alert');
  const errorAlert = document.getElementById('error-alert');

  if (successAlert) {
    setTimeout(() => {
      successAlert.style.transition = 'opacity 0.5s ease';
      successAlert.style.opacity = '0';
      setTimeout(() => successAlert.remove(), 500);
    }, 5000); // Hilang setelah 5 detik
  }
  if (errorAlert) {
     setTimeout(() => {
      errorAlert.style.transition = 'opacity 0.5s ease';
      errorAlert.style.opacity = '0';
      setTimeout(() => errorAlert.remove(), 500);
    }, 7000); // Hilang setelah 7 detik
  }
});
</script>
